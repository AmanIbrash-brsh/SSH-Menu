#!/bin/bash
# SSH Menu: keyboard-driven SSH hub on top of fzf and ~/.ssh/config.
# Run it in a terminal, or bind ssh-menu-popup to a hotkey (opens its own window, class "ssh-menu").
#   Enter ssh   Alt+T ssh+tmux   Alt+F sftp   Alt+Y copy addr   Alt+K push key
#   Alt+U/D upload/download   Alt+←/→ group filter   Alt+P PROD filter   Ctrl+R recheck   Alt+H all keys
#   Alt+N new host   Alt+E edit   Alt+G group   Alt+R toggle PROD   Tab mark   Alt+A/Z all/none
# Host metadata: "# group: X" / "# env: prod" comments above Host lines in ~/.ssh/config.
S=$(readlink -f "$0")
ROOT=$(cd "$(dirname "$S")/.." && pwd)
H="python3 -I $ROOT/lib/ssh_hosts.py"
state=${XDG_STATE_HOME:-$HOME/.local/state}/ssh-menu
mkdir -p "$state"; touch "$state/history"

# user settings (see config.example): SSHM_BROWSER, SSHM_FILES, SSHM_EDITOR, SSHM_FZF, ...
conf=${XDG_CONFIG_HOME:-$HOME/.config}/ssh-menu/config
[ -r "$conf" ] && . "$conf"

have() { command -v "$1" >/dev/null 2>&1; }
. "$ROOT/lib/term.sh"
# fzf: explicit setting > copy bundled by install.sh > system one
if [ -n "$SSHM_FZF" ]; then FZF=$SSHM_FZF
elif [ -x "$ROOT/libexec/fzf" ]; then FZF=$ROOT/libexec/fzf
else FZF=fzf; fi
FZF_MIN=0.63

c_ok=$'\e[32m'; c_err=$'\e[31m'; c_dim=$'\e[2m'; c_hi=$'\e[38;2;233;30;99m'; c_off=$'\e[0m'
say()  { printf '%s\n' "$*"; }
ask()  { local v; read -e -r -p "$c_hi$1$c_off ${2:+[$2] }" v; printf '%s' "${v:-$2}"; }
yes()  { local v; read -r -p "$c_hi$1$c_off [Y/n] " v; [[ ! $v =~ ^[nNнН] ]]; }
pause(){ read -r -s -n1 -p "${c_dim}press any key${c_off}"; echo; }
fz()   { "$FZF" --layout=reverse --height=45% --border=rounded --prompt="$1" --pointer='▌' \
              --color='bg+:#261d1e,fg+:#ffffff,hl:#e91e63,hl+:#ff6398,pointer:#e91e63,prompt:#e91e63,border:#e91e63,info:#8e7a7d' "${@:2}"; }

# ---------- desktop glue: everything optional, with fallbacks ----------
notify() { have notify-send && notify-send -a ssh-menu "$@" >/dev/null 2>&1; }
detach() { setsid -f "$@" >/dev/null 2>&1; }
unfloat() {  # the popup was a floating window; a real session should tile like any terminal
    if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && have hyprctl; then
        hyprctl dispatch 'hl.dsp.window.float({ action = "disable" })'   # Lua config
        hyprctl dispatch settiled active                                 # classic config
    elif [ -n "$SWAYSOCK" ] && have swaymsg; then
        swaymsg floating disable
    fi >/dev/null 2>&1
}
clip() {
    if [ -n "$WAYLAND_DISPLAY" ] && have wl-copy; then wl-copy
    elif have xclip; then xclip -selection clipboard
    elif have xsel; then xsel -b
    else return 1; fi
}
open_url() {
    if [ -n "$SSHM_BROWSER" ]; then eval "detach $SSHM_BROWSER \"\$1\""
    else detach xdg-open "$1"; fi
}

# ---------- connect ----------
run_ssh() {  # run_ssh <target> [remote command...]
    local t=$1; shift
    echo "$t" >> "$state/history"
    # become a normal tiled window once we are a session, not a menu
    [ "$SSH_MENU" = 1 ] && unfloat
    local env; env=$($H env "$t")
    if [ "$env" = prod ]; then printf '\e]2;⚠ PROD ssh: %s\a\e]11;#220a0f\a' "$t"
    else printf '\e]2;ssh: %s\a' "$t"; fi
    ssh "$t" "$@"; local rc=$?
    printf '\e]111\a'
    if [ $rc -ne 0 ]; then
        printf '\n%sssh %s exited with %s%s  (press Enter to close)' "$c_err" "$t" "$rc" "$c_off"; read -r _
    fi
    exit $rc
}
cmd_connect() { local t=${1:-$2}; [ -n "$t" ] && run_ssh "$t"; }
cmd_tmux()    { run_ssh "$1" -t 'command -v tmux >/dev/null && exec tmux new-session -A -s main || exec $SHELL -l'; }

# ---------- quick actions ----------
cmd_sftp() {
    local a jump url
    read -r a jump < <($H addr "$1")
    # jump hosts: let gvfs go through ssh config by alias; otherwise explicit user@host:port
    if [ -n "$jump" ]; then url="sftp://$1/"; else url="sftp://$a/"; fi
    notify "SFTP" "opening $a …"
    # detached, so it survives the menu window closing
    if [ -n "$SSHM_FILES" ]; then eval "detach $SSHM_FILES \"\$url\""
    elif have nautilus; then detach nautilus --new-window "$url"
    else detach xdg-open "$url"; fi
}
cmd_copy() {
    read -r a _ < <($H addr "$1")
    if printf %s "$a" | clip; then notify "ssh" "copied $a"; else notify "ssh" "no clipboard tool (wl-copy / xclip / xsel)"; fi
}

# ---------- keys ----------
pick_key() {
    local pubs sel name
    mapfile -t pubs < <(ls "$HOME"/.ssh/*.pub 2>/dev/null)
    sel=$( { printf '%s\n' "${pubs[@]}"; echo "+ generate new ed25519 key"; } | grep -v '^$' | fz 'key ❯ ' --height=30%) || return 1
    if [[ $sel == "+ generate"* ]]; then
        name=$(ask "key file name" "id_ed25519_$(date +%y%m)")
        [ -e "$HOME/.ssh/$name" ] && { say "${c_err}$name exists${c_off}" >&2; return 1; }
        ssh-keygen -t ed25519 -f "$HOME/.ssh/$name" -C "$USER@$(hostname -s)" >&2 || return 1
        sel="$HOME/.ssh/$name.pub"
    fi
    printf '%s' "$sel"
}
cmd_keys() {
    [ $# -eq 0 ] && return
    local pub ok=() bad=() h
    pub=$(pick_key) || return
    say "${c_hi}key:${c_off} $pub  ${c_hi}→${c_off} $*"; echo
    for h in "$@"; do
        say "${c_hi}── $h${c_off}"
        if ssh-copy-id -i "$pub" "$h"; then ok+=("$h"); else bad+=("$h"); fi
    done
    echo; [ ${#ok[@]} -gt 0 ]  && say "${c_ok}✓ ${ok[*]}${c_off}"
    [ ${#bad[@]} -gt 0 ] && say "${c_err}✗ ${bad[*]}${c_off}"
    [ ${#ok[@]} -gt 0 ] && $H audit "${ok[@]}"   # refresh the "password / no access" marks
    pause
}

# ---------- files ----------
remote_dir() {  # "~", "", "~/x" -> path relative to the remote home (works with any sftp server)
    local d=$1
    case "$d" in "~"|"~/") d= ;; "~/"*) d=${d#\~/} ;; esac
    printf '%s' "$d"
}
pick_local() {  # newline-separated local files
    if have zenity; then
        zenity --file-selection --multiple --separator=$'\n' --title="Upload to: $*" --filename="$HOME/" 2>/dev/null
    elif have kdialog; then
        kdialog --title "Upload to: $*" --getopenfilename "$HOME" --multiple --separate-output 2>/dev/null
    else
        (cd ~ && find . -maxdepth 4 -type f -not -path '*/.*' 2>/dev/null | sed 's|^\./||' \
            | fz 'upload ❯ ' --multi --height=100% | sed "s|^|$HOME/|")
    fi
}
cmd_upload() {
    [ $# -eq 0 ] && return
    local files dest h rc tmp
    mapfile -t files < <(pick_local "$*")
    [ -z "${files[0]}" ] && return
    clear
    say "${c_hi}upload${c_off}  ${c_dim}→ $*${c_off}"
    printf "  %s\n" "${files[@]}"; echo
    dest=$(ask "remote folder" "~")
    confirm_prod "$@" || return
    echo
    if [ $# -eq 1 ]; then      # one host: show scp's own progress bar
        scp -r -- "${files[@]}" "$1:$(remote_dir "$dest")" && say "${c_ok}✓ $1${c_off}" || say "${c_err}✗ $1${c_off}"
    else
        tmp=$(mktemp -d)
        for h in "$@"; do
            ( scp -q -r -- "${files[@]}" "$h:$(remote_dir "$dest")" 2>"$tmp/$h.err"; echo $? >"$tmp/$h.rc" ) &
        done
        say "${c_dim}uploading to $# hosts…${c_off}"; wait
        for h in "$@"; do
            if [ "$(cat "$tmp/$h.rc")" = 0 ]; then say "${c_ok}✓${c_off} $h"
            else say "${c_err}✗${c_off} $h  ${c_dim}$(tail -1 "$tmp/$h.err")${c_off}"; fi
        done
        rm -rf "$tmp"
    fi
    pause
}
browse_remote() {  # browse_remote host -> chosen remote paths, one per line
    local h=$1 dir=. out sel key p picks L
    while :; do
        out=$(ssh "$h" "cd -- $(printf %q "$dir") 2>/dev/null || cd; pwd; ls -1Ap" 2>/dev/null) \
            || { say "${c_err}cannot list files on $h${c_off}" >&2; pause >&2; return 1; }
        mapfile -t L <<< "$out"
        local cwd=${L[0]%/}
        sel=$( { echo "../"; printf '%s\n' "${L[@]:1}"; } | grep -v '^$' \
            | fz "$h:${cwd:-/}/ " --multi --height=100% --expect=alt-d,left \
                 --header=$'Enter open folder / take file   Tab mark   Alt+D take marked or folder   ← up' ) || return 1
        mapfile -t L <<< "$sel"; key=${L[0]}; picks=("${L[@]:1}")
        if [ "$key" = left ]; then dir="$cwd/.."; [ -z "$cwd" ] && dir=/; continue; fi
        if [ "$key" = alt-d ] || [ ${#picks[@]} -gt 1 ]; then
            for p in "${picks[@]}"; do [ "$p" != ../ ] && printf '%s/%s\n' "$cwd" "${p%/}"; done
            return
        fi
        p=${picks[0]}
        case "$p" in
            ../) dir="$cwd/.." ;;
            */)  dir="$cwd/${p%/}" ;;
            *)   printf '%s/%s\n' "$cwd" "$p"; return ;;
        esac
    done
}
cmd_download() {
    [ $# -eq 0 ] && return
    local paths=() p h base dl tmp
    if [ $# -eq 1 ]; then
        mapfile -t paths < <(browse_remote "$1")
    else
        clear; say "${c_hi}download${c_off}  ${c_dim}← $*${c_off}"; echo
        p=$(ask "remote file or folder (same path on every host)"); [ -n "$p" ] && paths=("$p")
    fi
    [ -z "${paths[0]}" ] && return
    dl=$(xdg-user-dir DOWNLOAD 2>/dev/null); dl=${dl:-$HOME/Downloads}
    clear
    if [ $# -eq 1 ]; then
        base="$dl/$1"; mkdir -p "$base"
        say "${c_hi}download${c_off}  ${c_dim}$1 → $base${c_off}"; printf "  %s\n" "${paths[@]}"; echo
        scp -r -- "${paths[@]/#/$1:}" "$base/" && say "${c_ok}✓ saved to $base${c_off}" || say "${c_err}✗ failed${c_off}"
    else
        base="$dl"; tmp=$(mktemp -d)
        for h in "$@"; do
            mkdir -p "$dl/$h"
            ( scp -q -r -- "$h:${paths[0]}" "$dl/$h/" 2>"$tmp/$h.err"; echo $? >"$tmp/$h.rc" ) &
        done
        say "${c_dim}downloading ${paths[0]} from $# hosts…${c_off}"; wait
        for h in "$@"; do
            if [ "$(cat "$tmp/$h.rc")" = 0 ]; then say "${c_ok}✓${c_off} $h  ${c_dim}$dl/$h/${c_off}"
            else say "${c_err}✗${c_off} $h  ${c_dim}$(tail -1 "$tmp/$h.err")${c_off}"; rmdir "$dl/$h" 2>/dev/null; fi
        done
        rm -rf "$tmp"
    fi
    echo; yes "open the folder?" && setsid -f xdg-open "$base" >/dev/null 2>&1
}

# ---------- new host / edit / group ----------
cmd_new() {
    clear; say "${c_hi}── new SSH host ──${c_off}  (Enter = default)"; echo
    local alias hostname user port jump group env key
    while :; do
        alias=$(ask "alias (name in the menu)"); [ -z "$alias" ] && return
        $H has "$alias" && { say "${c_err}already exists${c_off}"; continue; }
        [[ $alias =~ [[:space:]*?!] ]] && { say "${c_err}no spaces or wildcards${c_off}"; continue; }
        break
    done
    hostname=$(ask "HostName / IP" "$alias")
    user=$(ask "User" "root")
    port=$(ask "Port" "22")
    jump=$(ask "ProxyJump (empty = none)")
    group=$(ask "group (empty = none)")
    yes "mark as PROD (red window)?" && env=prod || env=
    key=$(ask "IdentityFile (empty = default)")
    echo; say "${c_dim}Host $alias → $user@$hostname:$port ${jump:+via $jump }${group:+[$group] }${env:+PROD}${c_off}"
    yes "save to ~/.ssh/config?" || return
    $H add "$alias" "$hostname" "$user" "$port" "$jump" "$group" "$env" "$key" || { pause; return; }
    say "${c_ok}saved${c_off} (backup in $state/backups)"
    yes "push your public key to it now?" && cmd_keys "$alias"
    echo "$alias" > "$state/lastnew"
}
cmd_edit() {
    local ed=${SSHM_EDITOR:-$EDITOR} e
    if [ -z "$ed" ]; then for e in micro nano vim vi; do have $e && { ed=$e; break; }; done; fi
    local l; l=$($H line "$1")
    $ed "+$l" ~/.ssh/config   # micro, nano, vim, emacs and most others understand +LINE
}
cmd_group() {
    [ $# -eq 0 ] && return
    local out rc g h
    out=$($H groups | fz "group ❯ " --height=40% --print-query \
        --header "pick a group or type a new name (empty = clear)"); rc=$?
    [ $rc -gt 1 ] && return          # Esc
    mapfile -t o <<< "$out"          # line 1 = query, line 2 = selection (if any)
    g=${o[1]:-${o[0]}}
    for h in "$@"; do $H set "$h" group "$g"; done
}
cmd_envtoggle() { for h in "$@"; do $H toggle-prod "$h"; done; }

# ---------- several hosts ----------
confirm_prod() {  # confirm_prod host... ; asks (default: no) only when PROD hosts are involved
    local prod=() h v
    for h in "$@"; do [ "$($H env "$h")" = prod ] && prod+=("$h"); done
    [ ${#prod[@]} -eq 0 ] && return 0
    say "${c_err}${#prod[@]} of $# hosts are PROD:${c_off} ${prod[*]}"
    read -r -p "${c_hi}continue?${c_off} [y/N] " v
    [[ $v =~ ^[yYдД] ]]
}
cmd_broadcast() {  # one tmux pane per host, keyboard input synced (Alt+S toggles)
    [ $# -eq 0 ] && return
    confirm_prod "$@" || return
    have tmux || { say "${c_err}broadcast needs tmux${c_off}"; pause; return; }
    local conf; conf="$ROOT/share/tmux-broadcast.conf"
    local T=(tmux -L sshmenu -f "$conf") sess="bc-$(date +%H%M%S)" h first=1
    for h in "$@"; do
        echo "$h" >> "$state/history"
        if [ $first = 1 ]; then "${T[@]}" new-session -d -s "$sess" -x 220 -y 60 "ssh $(printf %q "$h")"; first=0
        else "${T[@]}" split-window -t "$sess" "ssh $(printf %q "$h")"; "${T[@]}" select-layout -t "$sess" tiled; fi
        "${T[@]}" select-pane -t "$sess" -T "$h"
    done
    "${T[@]}" setw -t "$sess" synchronize-panes on
    ( term_run "broadcast: $# hosts" ssh-menu-broadcast "${T[@]}" attach -t "$sess" ) >/dev/null 2>&1 &
}
cmd_run() {  # run one command on all marked hosts, identical answers merged
    [ $# -eq 0 ] && return
    local cmd v
    set -o history; HISTFILE="$state/cmd_history"; history -r
    say "${c_dim}run on: $*${c_off}"
    read -e -r -p "${c_hi}\$${c_off} " cmd; [ -z "$cmd" ] && return
    history -s "$cmd"; history -w
    confirm_prod "$@" || return
    clear
    $H run "$cmd" "$@" | less -RFX
    pause
}
cmd_web() {  # open the host's web UI; first time asks for the URL and stores it as "# url:"
    local url; url=$($H url "$1")
    if [ -z "$url" ]; then
        url=$(ask "web UI for $1" "$($H url-default "$1")"); [ -z "$url" ] && return
        $H set "$1" url "$url"
    fi
    open_url "$url"
}

# ---------- dispatcher ----------
case "$1" in
    connect)    shift; cmd_connect "$@"; exit ;;
    tmux)       shift; cmd_tmux "$@"; exit ;;
    sftp)       shift; cmd_sftp "$@"; exit ;;
    copy)       shift; cmd_copy "$@"; exit ;;
    keys)       shift; cmd_keys "$@"; exit ;;
    new)        cmd_new; exit ;;
    edit)       shift; cmd_edit "$@"; exit ;;
    group)      shift; cmd_group "$@"; exit ;;
    envtoggle)  shift; cmd_envtoggle "$@"; exit ;;
    broadcast)  shift; cmd_broadcast "$@"; exit ;;
    run)        shift; cmd_run "$@"; exit ;;
    web)        shift; cmd_web "$@"; exit ;;
    upload)     shift; cmd_upload "$@"; exit ;;
    download)   shift; cmd_download "$@"; exit ;;
    preview)    shift; if [ -e "$state/help-on" ]; then $H help; else $H preview "$1"; fi; exit ;;
    help)       if [ -e "$state/help-on" ]; then rm -f "$state/help-on"; echo ' details '
                else touch "$state/help-on"; echo ' keys '; fi; exit ;;
    filter)     shift; $H filter "$1"; exit ;;
    label)      $H label; exit ;;
    list)       $H list; exit ;;
    live)       $H live; exit ;;
    refresh)    $H refresh; exit ;;
esac

# ---------- menu ----------
# one quiet line of the most used keys; Alt+H (or F1) shows all of them in the side panel
key() { printf '\e[1;38;2;248;187;217m%s\e[0m \e[38;2;150;135;140m%s\e[0m   ' "$1" "$2"; }
ftr=$(key Enter ssh; key Alt+T tmux; key Alt+U/D files; key 'Alt+← →' group; key Alt+H 'all keys')

v=$("$FZF" --version 2>/dev/null | awk '{print $1}')
if [ -z "$v" ] || [ "$(printf '%s\n' "$FZF_MIN" "$v" | sort -V | head -1)" != "$FZF_MIN" ]; then
    echo "ssh-menu needs fzf >= $FZF_MIN (found: ${v:-none})."
    echo "Run ./install.sh again: it downloads a recent fzf just for ssh-menu."
    [ "$SSH_MENU" = 1 ] && read -r -p "press Enter to close" _
    exit 1
fi
command -v python3 >/dev/null || { echo "ssh-menu needs python3"; exit 1; }

rm -f "$state/help-on"; $H filter reset

$H list | "$FZF" --ansi --multi --layout=reverse --height=100% --tiebreak=index \
    --style=full:rounded --padding=1,2 --highlight-line \
    --prompt='  ' --pointer='▌' --gutter=' ' --marker='✓' --info=inline-right --no-scrollbar \
    --input-label=' ssh ' --list-label="$($H label)" --preview-label=' details ' \
    --ghost='type to filter, or user@host to connect to anything' \
    --footer "$ftr" --footer-border=none \
    --color='bg+:#2a2024,fg+:#ffffff,hl:#e91e63,hl+:#ff6398,pointer:#e91e63,prompt:#e91e63,info:#8e7a7d,marker:#f8bbd9,spinner:#e91e63,ghost:#6b5a5e,gutter:-1' \
    --color='border:#3a2a2e,list-border:#3a2a2e,preview-border:#3a2a2e,input-border:#e91e63' \
    --color='label:#e91e63,input-label:#e91e63,list-label:#8e7a7d,preview-label:#8e7a7d,footer:-1' \
    --preview "$S preview {2}" --preview-window='right:34%:wrap' \
    --bind "start:reload-sync($S live)" \
    --bind "ctrl-r:reload-sync($S refresh)+refresh-preview" \
    --bind "alt-h,f1:transform-preview-label($S help)+refresh-preview" \
    --bind "alt-left:execute-silent($S filter prev)+reload-sync($S list)+transform-list-label($S label)" \
    --bind "alt-right:execute-silent($S filter next)+reload-sync($S list)+transform-list-label($S label)" \
    --bind "alt-p:execute-silent($S filter prod)+reload-sync($S list)+transform-list-label($S label)" \
    --bind "alt-u:execute($S upload {+2})" \
    --bind "alt-d:execute($S download {+2})" \
    --bind "enter:become($S connect {2} {q})" \
    --bind "alt-t:become($S tmux {2})" \
    --bind "alt-f:execute-silent($S sftp {2})+abort" \
    --bind "alt-y:execute-silent($S copy {2})+abort" \
    --bind "alt-k:execute($S keys {+2})+reload($S list)" \
    --bind "alt-n:execute($S new)+reload($S list)+transform-query(cat $state/lastnew 2>/dev/null; rm -f $state/lastnew)" \
    --bind "alt-e:execute($S edit {2})+reload($S live)" \
    --bind "alt-g:execute($S group {+2})+reload($S list)" \
    --bind "alt-r:execute-silent($S envtoggle {+2})+reload($S list)" \
    --bind "alt-b:execute($S broadcast {+2})+abort" \
    --bind "alt-x:execute($S run {+2})" \
    --bind "alt-w:execute($S web {2})+reload($S list)+abort" \
    --bind "alt-a:select-all,alt-z:deselect-all"
